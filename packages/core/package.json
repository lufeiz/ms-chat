{
  "name": "@ms-chat/core",
  "version": "0.0.2-beta.4",
  "publishConfig": {
    "module": "dist/ms-chat-core.es.js",
    "main": "dist/ms-chat-core.cjs.js",
    "types": "dist/index.d.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ms-chat-core.es.js",
      "require": "./dist/ms-chat-core.cjs.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2.es.js",
      "require": "./dist/v2.cjs.js"
    },
    "./src": "./src/index.ts",
    "./src/v2": "./src/v2/index.ts",
    "./src/utils": "./src/utils",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build -w",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "overrides": {},
  "peerDependencies": {
    "lodash-es": "^4.17.21"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "lodash-es": "^4.17.21",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/web-worker": "^4.1.7",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.7"
  }
}
